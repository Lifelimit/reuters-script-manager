{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "Reuters Script Manager",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": false,
        "open": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "exists": true
      },
      "process": {
        "all": false,
        "relaunch": false,
        "exit": false
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.company.reuters-script-manager",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png"
      ],
      "category": "DeveloperTool",
      "shortDescription": "Reuters Script Manager",
      "longDescription": "A cross-platform desktop application for managing and launching Reuters scripts",
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      },
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "",
        "exceptionDomain": "",
        "signingIdentity": null,
        "providerShortName": null,
        "entitlements": null
      },
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      },
      "resources": [
        "../scripts/snyk_compare.py",
        "../scripts/datadome_compare.py",
        "../Documents/Main/requirements.txt",
        "../Documents/Main/README.md",
        "../Documents/Snyk Report Compare/Snyk_Compare_Script_User_Guide.md",
        "../Documents/DataDome Verified Bots Compare/DataDome_Compare_Script_User_Guide.md"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Reuters Script Manager",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "center": true
      }
    ]
  }
}